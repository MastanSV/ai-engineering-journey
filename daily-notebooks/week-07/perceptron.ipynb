   "source": [
    "def prediction(x, w, b):\n",
    "    y_pred = w * x + b\n",
    "    error = y_true - y_pred\n",
    "\n",
    "    lr = 1\n",
    "    w += lr * error * x\n",
    "    b += lr * error\n",
    "\n",
    "x_true = 10\n",
    "y_true = 20\n",
    "\n",
    "y_pred = prediction(10, 2 , 1)\n",
    "\n"
   ]
  }
